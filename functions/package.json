{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "build:watch": "tsrs -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsrs --noEmit",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@google-cloud/pubsub": "6.2.0",
    "@googleapis/gmail": "22.0.1",
    "firebase-admin": "13.6.0",
    "firebase-functions": "7.0.0"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24"
  }
}
